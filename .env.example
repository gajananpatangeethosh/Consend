# ==============================================================================
# Consent Chain Environment Configuration
# Full-Stack Next.js + Supabase + MST Blockchain + BridgeKey Wallet
# ==============================================================================

# Supabase Platform Configuration (Optional for local testnet demo, required for hosted DB)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Application Domain
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MST Blockchain Network Configuration
# Supported options: coral (Chain ID 54635) | legacy (Chain ID 91562037)
MST_NETWORK=coral
MST_CHAIN_ID=54635
MST_RPC_URL=https://coralrpc.mstblockchain.com
MST_EXPLORER_URL=https://coral.mstscan.com

# Deployed ConsentRegistry Contract Address on MST Coral Testnet
CONSENT_REGISTRY_ADDRESS=0x8A9b73641571d1D053e19277fD63Ec03b3096eF1
NEXT_PUBLIC_CONSENT_REGISTRY_ADDRESS=0x8A9b73641571d1D053e19277fD63Ec03b3096eF1

# MST Testnet Relayer Private Key (Server-only, NEVER expose to client)
# Used for server-sponsored audit logging if user chooses relayer transactions
MST_RELAYER_PRIVATE_KEY=
